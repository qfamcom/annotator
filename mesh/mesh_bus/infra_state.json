{
  "status": "provisioning",
  "version": "0.1.0",
  "environment": "repo-local-v1",
  "resources": {
    "compute": [
      "api_service_runtime",
      "export_worker_runtime"
    ],
    "database": [
      "postgresql: annotation_metadata_store"
    ],
    "network": [
      "api_worker_private_channel"
    ],
    "secrets": [
      "object_storage_credentials",
      "auth_signing_secret",
      "service_runtime_config"
    ],
    "object_storage": [
      "minio: annotation-uploads",
      "minio: annotation-exports"
    ],
    "queue_cache": [
      "redis: export_job_state"
    ]
  },
  "limits": {
    "max_file_size_mb": 50,
    "max_page_count": 100
  },
  "targets": [
    "local",
    "staging",
    "prod"
  ],
  "phase2_checkpoints": {
    "infra_scaffold_files_created": true,
    "local_stack_defined": true,
