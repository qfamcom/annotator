# Service ports
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Postgres
POSTGRES_DB=annotation_mesh
POSTGRES_USER=annotator
POSTGRES_PASSWORD=change_me

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET_UPLOADS=annotation-uploads
MINIO_BUCKET_EXPORTS=annotation-exports

# App-facing connection URLs (for later phase integration)
DATABASE_URL=postgresql://annotator:change_me@localhost:5432/annotation_mesh
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=change_me_minio
OBJECT_STORAGE_REGION=us-east-1

# v1 limits from PRD
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=100
